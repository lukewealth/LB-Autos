{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": null,
  "framework": null,

  "cleanUrls": true,
  "trailingSlash": false,

  "rewrites": [
    { "source": "/send-contact.php",    "destination": "/api/contact" },
    { "source": "/send-booking.php",    "destination": "/api/booking" },
    { "source": "/send-newsletter.php", "destination": "/api/newsletter" }
  ],

  "functions": {
    "api/contact.js":    { "maxDuration": 10 },
    "api/booking.js":    { "maxDuration": 10 },
    "api/newsletter.js": { "maxDuration": 10 }
  },

  "headers": [
    {
      "source": "/(.*)\\.(jpg|jpeg|png|gif|webp|avif|svg|woff2?|ttf|otf|eot|ico|css|js|map)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
